{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agentPushNotifEnabled": true,
  "editorMode": "vim",
  "effortLevel": "high",
  "enabledPlugins": {
    "banana@banana-local": true,
    "claude-hud@claude-hud": true,
    "claude-md-management@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "explanatory-output-style@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "hookify@claude-plugins-official": true,
    "oh-my-claudecode@omc": true,
    "playwright@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "specrail@specrail": true,
    "superpowers@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "extraKnownMarketplaces": {
    "banana-local": {
      "source": {
        "path": "/Users/sungminoh/Development/banana",
        "source": "directory"
      }
    },
    "omc": {
      "source": {
        "source": "git",
        "url": "https://github.com/Yeachan-Heo/oh-my-claudecode.git"
      }
    },
    "specrail": {
      "source": {
        "path": "/Users/sungminoh/Development/specrail",
        "source": "directory"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" ]; then \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" post_tool; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" ]; then CLAUDE_TOOL_NAME=\"$(jq -r '.tool_name // \"unknown\"' 2>/dev/null || printf unknown)\" \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" pre_tool; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" ]; then \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" session_start; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" ]; then \"$HOME/.termpilot/bin/cc-monitor-hook.sh\" stop; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      },
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "if [ -x \"$HOME/.config/iterm2/cc-status\" ]; then \"$HOME/.config/iterm2/cc-status\"; fi",
            "type": "command"
          }
        ]
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "command": "node /Users/sungminoh/.claude/hud/omc-hud.mjs",
    "type": "command"
  }
}
